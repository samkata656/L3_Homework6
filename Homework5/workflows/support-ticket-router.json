    {
      "parameters": {
        "inputText": "={{ $json[\"Problem:\"] }}",
        "categories": {
          "categories": [
            {
              "category": "Sales",
              "description": "Questions about buying, prices, quotes, upgrading or downgrading plans, adding users or licenses, discounts or offers promised by a sales person, and interest in new products."
            },
            {
              "category": "Technical",
              "description": "Something in the product does not work or the writer needs technical help: errors, login or password problems, bugs, broken features, missing or lost data, problems after updates, integrations and API questions."
            },
            {
              "category": "Billing",
              "description": "Money that was already charged or needs to be paid: double charges, refunds, invoices and receipts, payment confirmations, VAT details, and accounts suspended because of payment."
            },
            {
              "category": "General",
              "description": "Anything that does not fit the other three: changing company or contact details, feedback and compliments, complaints about communication or response times, and general questions about the company."
            }
          ]
        },
        "options": {
          "multiClass": false,
          "fallback": "discard",
          "systemPromptTemplate": "You are a support ticket router. Read the support request and assign it to exactly one department from this list: {categories}\n\nRules:\n- Decide based on the MAIN problem the writer needs solved, not on words mentioned in passing.\n- If the problem is about money already charged, refunds, invoices or payments, choose Billing, even if a technical issue is also mentioned.\n- If the problem is about a price, offer or discount that was promised before buying, choose Sales.\n- If something in the product is broken or not working, choose Technical, even if the writer also complains about paying for it.\n- If no other department clearly fits, choose General.\n- Ignore names, greetings and the tone of the message; only the topic matters here.\n\nUse the provided formatting instructions below. Don't explain, and only output the JSON.",
          "enableAutoFixing": true
        }
      },
