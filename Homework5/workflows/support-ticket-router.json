    {
      "parameters": {
        "inputText": "={{ $json[\"Problem:\"] }}",
        "options": {
          "categories": "Critical, Negative, Neutral, Positive",
          "systemPromptTemplate": "You are a support ticket triage assistant. Your job is to read a support request from an employee or customer and decide how URGENT it is, based on the tone and the impact described.\n\nCategorize the text into exactly one of these categories: {categories}\n\nCategory definitions:\n- Critical: Work or business is stopped or seriously blocked, data is lost, money is at risk, there is a deadline today or tomorrow, or the writer threatens legal action or cancellation. Strong words like \"urgent\", \"immediately\", \"disaster\" usually point here.\n- Negative: The writer is unhappy, frustrated or disappointed, but nothing is completely stopped and there is no emergency. Examples: a bug that is annoying, a wrong charge, no reply to earlier messages.\n- Neutral: A normal request or question with no strong emotion. Examples: asking for an invoice, a price quote, changing an address, a technical question.\n- Positive: The writer is happy, gives praise or thanks, or shows interest in buying or upgrading.\n\nRules:\n- Judge urgency by IMPACT first, tone second. A calm message describing lost data is still Critical.\n- If a message mixes praise with a complaint, choose the category of the complaint.\n- If you are unsure between two categories, choose the more urgent one so a human checks it.\n- Ignore names, emails and greetings; focus only on the problem.\n\nUse the provided formatting instructions. Only output the JSON.",
          "includeDetailedResults": true,
          "enableAutoFixing": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.sentimentAnalysis",
      "typeVersion": 1.1,
      "position": [
        288,
        -32
      ],
      "id": "a0d32065-1124-4333-a205-f5542143f99c",
      "name": "Sentiment Analysis"
