iv></td> <td width=\"4\"></td> <td width=\"33%\" style=\"background:#232328;border-radius:8px;padding:14px;\"><div style=\"font-family:'JetBrains Mono',Consolas,monospace;font-size:10px;color:#8C8C96;\">REIMBURSED</div><div style=\"font-size:22px;font-weight:700;color:#FF6B35;\">{{ $('Summarize').all().reduce((s, i) => s + i.json.sum_approved_amount_eur, 0).toFixed(2) }} €</div></td> </tr></table> <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#232328;border-left:3px solid #FF6B35;border-radius:6px;margin:0 0 20px;\"> <tr><td style=\"padding:14px 16px;\"><div style=\"font-family:'JetBrains Mono',Consolas,monospace;font-size:11px;color:#8C8C96;margin-bottom:6px;\">SUMMARY</div><div style=\"font-size:14px;font-weight:300;color:#F2EFE9;line-height:1.6;\">{{ $json.text.replace(/\\n/g, '<br>') }}</div></td></tr> </table> <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border:1px solid #2E2E35;border-radius:8px;font-size:13px;color:#F2EFE9;\"> <tr style=\"background:#232328;font-family:'JetBrains Mono',Consolas,monospace;font-size:10px;color:#8C8C96;\"><td style=\"padding:10px 12px;\">DEPARTMENT</td><td style=\"padding:10px 12px;\">CATEGORY</td><td style=\"padding:10px 12px;text-align:right;\">RECEIPTS</td><td style=\"padding:10px 12px;text-align:right;\">SPENT €</td><td style=\"padding:10px 12px;text-align:right;\">REIMBURSED €</td></tr> {{ $('Summarize').all().map(i => `<tr><td style=\"padding:10px 12px;border-top:1px solid #2E2E35;\">${i.json.department}</td><td style=\"padding:10px 12px;border-top:1px solid #2E2E35;\">${i.json.category}</td><td style=\"padding:10px 12px;border-top:1px solid #2E2E35;text-align:right;\">${i.json.count_id}</td><td style=\"padding:10px 12px;border-top:1px solid #2E2E35;text-align:right;\">${i.json.sum_total_eur.toFixed(2)}</td><td style=\"padding:10px 12px;border-top:1px solid #2E2E35;text-align:right;\">${i.json.sum_approved_amount_eur.toFixed(2)}</td></tr>`).join('') }} </table> </td></tr>