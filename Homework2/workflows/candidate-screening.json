            {
              "id": "57ebc972-3264-4c09-b10e-ee98c0a30e7c",
              "name": "Phone number",
              "value": "={{ (() => {\n  const code = $('On form submission').item.json[\"What is your phone number country code?\"].match(/\\d+/)[0];\n  let n = $('On form submission').item.json[\"What is your phone number?\"].replace(/\\D/g, '');\n  if (n.startsWith('00' + code)) n = n.slice(code.length + 2);\n  else if (n.startsWith(code)) n = n.slice(code.length);\n  n = n.replace(/^0+/, '');\n  return '+' + code + n;\n})() }}",
              "type": "string"
            },
            {
              "id": "9bcf9dcf-f243-4314-9af4-b29583d8b3bf",
              "name": "Email",
              "value": "={{ $('If').item.json.output.email }}",
              "type": "string"
            },
